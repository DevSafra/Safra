# ---------------------------------------------------------------------------
# SAFRA — environment template. Copy to .env and fill in real values.
# NEVER commit .env. Every value below is a placeholder.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000

# The API's own public base URL, used to build media links it serves. Distinct from
# API_URL, which is how the web apps reach it — behind a load balancer these differ.
API_URL_SELF=http://localhost:4000

# Port the API listens on. Defaults to 4000; set explicitly in a container.
PORT=4000

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql://safra:safra@localhost:5432/safra
DATABASE_POOL_MAX=20

# --- Redis (cache + BullMQ queue) ----------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth ----------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Encrypts staff TOTP secrets and partner payout details at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=replace-me

# The key being rotated OUT, for decryption only. Leave EMPTY normally.
# Set it during a key rotation so both keys decrypt while only the new one encrypts —
# see docs/runbooks/encryption-key-rotation.md. Rotating without it locks every staff
# account out of the console at once.
FIELD_ENCRYPTION_KEY_PREVIOUS=

# --- Object storage (S3-compatible: Cloudflare R2 / MinIO) ---------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=safra-media
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

# Public base URL for objects, when the bucket is fronted by a CDN. Optional: without
# it, media is served through the API. Required in production if you do not want every
# image request occupying an application worker.
S3_PUBLIC_URL=

# --- Payment providers ---------------------------------------------------
# Merchant of record is Safra Technologies GmbH (ADR 0002).
#
# WHICH provider serves which country is NOT configured here — it lives in the
# `payment.provider_routing` setting so a super admin can change it without a
# deploy (P-005). Only credentials and kill-switches belong in the environment.
#
# The one rail available with no PSP contract is `manual_transfer` (SEPA credit
# transfer, confirmed by finance). It needs no credentials, which is why nothing
# is required below for the platform to take money.
#
# Approved customer-facing methods: Visa, Mastercard, Klarna, Sham Cash.
# PayPal and Apple Pay were removed on instruction; Stripe is excluded as a
# gateway. All three exclusions are policy, not configuration — see ADR 0002 —
# so there is deliberately no env switch to re-enable them.
#
# Each approved method still needs its own agreement before it can be routed:
# an acquirer for the card schemes, a merchant agreement for Klarna, a Syrian
# collecting party for Sham Cash.

# Fake gateway for development and CI. It captures payments without money, so
# the API REFUSES TO BOOT with this true and NODE_ENV=production.
PAYMENT_SIMULATOR_ENABLED=false
# Comma-separated, newest first. Several are valid at once so a webhook secret
# can be rotated without a window where live webhooks are rejected.
# Required only when the simulator is enabled. openssl rand -base64 48
PAYMENT_SIMULATOR_WEBHOOK_SECRETS=

# --- Notifications -------------------------------------------------------
# NOT YET WIRED. No code reads these — notifications are unbuilt (see FUTURE-WORK
# S-2, blocked on the WhatsApp BSP decision, roadmap item 192). Listed so the
# eventual shape is known; setting them today does nothing.
WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=replace-me
WHATSAPP_PHONE_NUMBER_ID=replace-me
SMTP_URL=smtp://localhost:1025
MAIL_FROM="SAFRA <no-reply@safra.example>"

# --- Maps ----------------------------------------------------------------
# NOT YET WIRED. Blocked on the maps billing account (roadmap item 195).
MAPTILER_API_KEY=replace-me

# --- Observability -------------------------------------------------------
# EU consolidated sanctions list (ADR 0002). Required before partners can be
# verified; without it the list goes stale and verification refuses. The publisher
# issues the token, so this is set per deployment rather than shipped.
SANCTIONS_FEED_URL=

LOG_LEVEL=debug

# NOT YET WIRED — this is the dangerous kind of placeholder, so it is labelled.
# Nothing reads these. Setting SENTRY_DSN does NOT turn on error tracking, and
# believing it did would hide the fact that there is none. See FUTURE-WORK S-1.
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
