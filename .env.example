# ---------------------------------------------------------------------------
# SAFRA — environment template. Copy to .env and fill in real values.
# NEVER commit .env. Every value below is a placeholder.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:4000

# --- Database -------------------------------------------------------------
DATABASE_URL=postgresql://safra:safra@localhost:5432/safra
DATABASE_POOL_MAX=20

# --- Redis (cache + BullMQ queue) ----------------------------------------
REDIS_URL=redis://localhost:6379

# --- Auth ----------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Encrypts staff TOTP secrets and partner payout details at rest (AES-256-GCM).
# Generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=replace-me

# --- Object storage (S3-compatible: Cloudflare R2 / MinIO) ---------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=safra-media
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me

# --- Payment providers ---------------------------------------------------
# Enabled providers, resolved per country at runtime. See ADR 0002:
# the merchant entity is not yet final, so nothing here is load-bearing yet.
PAYMENT_PROVIDERS=sham_cash
SHAM_CASH_API_KEY=replace-me
SHAM_CASH_WEBHOOK_SECRET=replace-me
# STRIPE_SECRET_KEY=            # unavailable to a Syrian entity as of 2026-07
# PAYPAL_CLIENT_ID=             # PayPal declined Syria access, March 2026

# --- Notifications -------------------------------------------------------
WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=replace-me
WHATSAPP_PHONE_NUMBER_ID=replace-me
SMTP_URL=smtp://localhost:1025
MAIL_FROM="SAFRA <no-reply@safra.example>"

# --- Maps ----------------------------------------------------------------
MAPTILER_API_KEY=replace-me

# --- Observability -------------------------------------------------------
LOG_LEVEL=debug
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
