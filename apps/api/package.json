{
  "name": "@safra/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import @swc-node/register/esm-register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo",
    "bootstrap:admin": "tsx src/scripts/bootstrap-super-admin.ts",
    "rotate:encryption-key": "tsx src/scripts/rotate-encryption-key.ts",
    "dev:totp": "tsx src/scripts/dev-totp.ts",
    "db:testbed": "tsx src/scripts/seed-testbed.ts",
    "partner:code": "tsx src/scripts/partner-totp.ts",
    "media:bootstrap": "tsx src/scripts/bootstrap-media.ts",
    "load:accounts": "tsx src/scripts/prepare-load-accounts.ts",
    "load:token": "tsx src/scripts/load-staff-token.ts",
    "start:worker": "node dist/worker.js",
    "dev:worker": "node --watch --import @swc-node/register/esm-register src/worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1098.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.4.0",
    "@node-rs/argon2": "^2.0.0",
    "@safra/contracts": "workspace:*",
    "@safra/db": "workspace:*",
    "@safra/i18n": "workspace:*",
    "bullmq": "^6.1.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "jose": "^6.0.0",
    "nodemailer": "^9.0.3",
    "otplib": "^12.0.1",
    "playwright-core": "^1.62.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "uuid": "^11.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.15.47",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.1"
  }
}
