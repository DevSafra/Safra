{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No rootDir/outDir: this package is consumed directly from source via its
    // "exports" map, so it is typechecked but never separately emitted.
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "drizzle.config.ts"]
}
