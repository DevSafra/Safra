{
  "name": "safra",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run build --filter='./packages/*' && eslint .",
    "typecheck": "turbo run typecheck && tsc -p e2e/tsconfig.json --noEmit",
    "test": "turbo run build --filter='./packages/*' && vitest run",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yaml,yml}\"",
    "db:generate": "pnpm --filter @safra/db db:generate",
    "db:migrate": "pnpm --filter @safra/db db:migrate",
    "db:seed": "pnpm --filter @safra/db db:seed",
    "db:studio": "pnpm --filter @safra/db db:studio",
    "audit:deps": "pnpm audit --audit-level=moderate",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run audit:deps",
    "lint:fix": "turbo run build --filter='./packages/*' && eslint . --fix",
    "prepare": "git config core.hooksPath .githooks || true",
    "bootstrap:admin": "pnpm --filter @safra/api bootstrap:admin",
    "rotate:encryption-key": "pnpm --filter @safra/api rotate:encryption-key",
    "code": "sh -c 'set -a; . ./.env; set +a; pnpm --filter @safra/api dev:totp'",
    "e2e": "sh -c 'set -a; . ./.env; set +a; playwright test'",
    "e2e:headed": "sh -c 'set -a; . ./.env; set +a; playwright test --headed'",
    "db:reset-dev": "pnpm --filter @safra/db db:reset-dev",
    "db:testbed": "pnpm --filter @safra/api db:testbed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.12",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "otplib": "^12.0.1",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": ">=1.1.18 <2",
      "brace-expansion@2": "2.0.2",
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.0",
      "esbuild": ">=0.25.0",
      "brace-expansion@5": ">=5.0.9 <6"
    }
  }
}
